{
    "uid": "wandersphere-main",
    "title": "WanderSphere - Service Metrics",
    "description": "Comprehensive monitoring dashboard for WanderSphere microservices",
    "tags": [
        "wandersphere",
        "microservices"
    ],
    "timezone": "browser",
    "schemaVersion": 37,
    "version": 1,
    "refresh": "10s",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "fiscalYearStartMonth": 0,
    "liveNow": false,
    "weekStart": "",
    "editable": true,
    "graphTooltip": 1,
    "templating": {
        "list": [
            {
                "current": {
                    "selected": true,
                    "text": "All",
                    "value": "$__all"
                },
                "datasource": {
                    "type": "prometheus",
                    "uid": ""
                },
                "definition": "label_values(up, job)",
                "hide": 0,
                "includeAll": true,
                "label": "Service",
                "multi": true,
                "name": "job",
                "options": [],
                "query": {
                    "query": "label_values(up, job)",
                    "refId": "StandardVariableQuery"
                },
                "refresh": 2,
                "regex": "",
                "skipUrlSync": false,
                "sort": 1,
                "type": "query"
            }
        ]
    },
    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 100,
            "title": "HTTP Metrics",
            "type": "row"
        },
        {
            "id": 1,
            "title": "HTTP Request Rate",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 10,
                "x": 0,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": ""
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisLabel": "req/s",
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 2,
                        "pointSize": 5,
                        "showPoints": "auto",
                        "spanNulls": false
                    },
                    "unit": "reqps"
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "calcs": [
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{job=~\"$job\"}[5m])) by (method, path, status)",
                    "legendFormat": "{{method}} {{path}} [{{status}}]",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "title": "HTTP Request Duration (p50/p95/p99)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 10,
                "x": 10,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": ""
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisCenteredZero": false,
                        "axisLabel": "duration",
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 2,
                        "pointSize": 5,
                        "showPoints": "auto",
                        "spanNulls": false
                    },
                    "unit": "s"
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "calcs": [
                        "mean",
                        "max"
                    ],
                    "displayMode": "table",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))",
                    "legendFormat": "p95",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))",
                    "legendFormat": "p99",
                    "refId": "C"
                }
            ]
        },
        {
            "id": 3,
            "title": "HTTP Error Rate (5xx)",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 4,
                "x": 20,
                "y": 1
            },
            "datasource": {
                "type": "prometheus",
                "uid": ""
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.01
                            },
                            {
                                "color": "red",
                                "value": 0.1
                            }
                        ]
                    },
                    "unit": "reqps"
                },
                "overrides": []
            },
            "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "textMode": "auto"
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{job=~\"$job\", status=~\"5..\"}[5m]))",
                    "legendFormat": "5xx errors/s",
                    "refId": "A"
                }
            ]
        },
